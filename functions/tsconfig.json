{
  // Pages Functions run on the Workers runtime, not in the browser: Workers types, no DOM.
  // Checked by `npm run typecheck` alongside the app's tsconfig.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"]
}
